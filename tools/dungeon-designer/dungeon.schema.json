{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Azure Mines dungeon authoring v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "document_type": {
      "const": "dungeon"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$",
      "maxLength": 100
    },
    "name": {
      "type": "string",
      "pattern": "\\S",
      "maxLength": 200
    },
    "author_notes": {
      "type": "string",
      "maxLength": 20000
    },
    "width": {
      "type": "integer",
      "minimum": 8,
      "maximum": 64
    },
    "height": {
      "type": "integer",
      "minimum": 8,
      "maximum": 64
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "pattern": "\\S",
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "maxLength": 20000
          },
          "author_notes": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "author_notes"
        ],
        "additionalProperties": false
      },
      "maxItems": 256
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "tile": {
            "enum": [
              "floor",
              "corridor",
              "door"
            ]
          },
          "area_id": {
            "type": "string",
            "pattern": "^[a-z0-9_]*$",
            "maxLength": 100
          }
        },
        "required": [
          "x",
          "y",
          "tile",
          "area_id"
        ],
        "additionalProperties": false
      },
      "maxItems": 4096
    },
    "markers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$",
            "maxLength": 100
          },
          "name": {
            "type": "string",
            "pattern": "\\S",
            "maxLength": 200
          },
          "type": {
            "enum": [
              "entrance",
              "exit",
              "stairs",
              "passage",
              "npc",
              "encounter",
              "secret",
              "conversation"
            ]
          },
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 63
          },
          "description": {
            "type": "string",
            "maxLength": 20000
          },
          "author_notes": {
            "type": "string",
            "maxLength": 20000
          },
          "reference": {
            "type": "string",
            "maxLength": 20000
          },
          "target_document": {
            "type": "string",
            "pattern": "^[a-z0-9_]*$",
            "maxLength": 100
          },
          "target_location": {
            "type": "string",
            "pattern": "^[a-z0-9_]*$",
            "maxLength": 100
          }
        },
        "required": [
          "id",
          "name",
          "type",
          "x",
          "y",
          "description",
          "author_notes",
          "reference",
          "target_document",
          "target_location"
        ],
        "additionalProperties": false
      },
      "maxItems": 1024
    }
  },
  "required": [
    "schema_version",
    "document_type",
    "id",
    "name",
    "author_notes",
    "width",
    "height",
    "areas",
    "cells",
    "markers"
  ],
  "additionalProperties": false
}
