extends SceneTree
const F = preload("res://tests/web_fixture.gd")
func _initialize() -> void:
    var b := F.battle()
    var before := F.state(b)
    var p := b.preview_area_spell("web", Vector2i(4, 4))
    assert(p.anchor == Vector2i(3, 3) and p.nominal_cells.size() == 16 and p.affected_cells.size() == 16)
    assert(F.state(b) == before)
    for y in range(3, 7): b.walls.append(Vector2i(5, y))
    p = b.preview_area_spell("web", Vector2i(4, 4))
    assert(p.reason.is_empty() and p.affected_cells.size() == 8 and p.blocked_cells.size() == 8)
    p.affected_cells.clear()
    assert(b.preview_area_spell("web", Vector2i(4, 4)).affected_cells.size() == 8)
    assert(b.cast_area_spell("web", Vector2i(4, 4)))
    assert(b.active_effects.values()[0].cells.size() == 8 and b.movement_cost(Vector2i(6, 4)) == 1)
    b = F.battle()
    b.obstacles.append({"position": Vector2i(4, 4), "size": Vector2i.ONE, "blocks_movement": true, "blocks_area": false})
    b.blocked_cells.append(Vector2i(4, 4))
    assert(b.cast_area_spell("web", Vector2i(4, 4)))
    b = F.battle()
    assert(not b.area_spell_reason("web", Vector2i(0, 4)).is_empty())
    assert(b.area_spell_reason("web", Vector2i(13, 1)).is_empty())
    b.walls.append(Vector2i(4, 4))
    before = F.state(b)
    assert(not b.cast_area_spell("web", Vector2i(4, 4)) and F.state(b) == before)
    print("PASS: v0531 central mapping, pure snapshots, masking/pockets, low cover and atomic failure")
    quit()
