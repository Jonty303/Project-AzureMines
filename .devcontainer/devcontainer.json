{
  "name": "Azure Mines — pinned Godot 4.5.2 and iPad Web preview",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python3 scripts/validate_template.py --project && python3 scripts/validate_toolchain.py && python3 scripts/bootstrap_codespaces.py",
  "forwardPorts": [
    8765
  ],
  "portsAttributes": {
    "8765": {
      "label": "Azure Mines iPad Web preview",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "yzhang.markdown-all-in-one",
        "geequlim.godot-tools"
      ],
      "settings": {
        "godotTools.editorPath.godot4": "/home/vscode/.local/bin/godot",
        "godotTools.lsp.headless": true
      }
    }
  },
  "remoteUser": "vscode",
  "postStartCommand": "python3 scripts/codespaces_web_preview.py start"
}
